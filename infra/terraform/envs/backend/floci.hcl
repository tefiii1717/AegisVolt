# terraform init -backend-config=backend/floci.hcl   (Floci: emulador local de AWS en :4566)
# El bucket (versionado) y la tabla de bloqueo los crea infra/terraform/bootstrap con use_floci=true.
bucket                      = "aegisvolt-tfstate"
dynamodb_table              = "aegisvolt-tflock"
region                      = "us-east-1"
access_key                  = "test"
secret_key                  = "test"
use_path_style              = true
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
endpoints = {
  s3       = "http://localhost:4566"
  dynamodb = "http://localhost:4566"
  sts      = "http://localhost:4566"
  iam      = "http://localhost:4566"
}
